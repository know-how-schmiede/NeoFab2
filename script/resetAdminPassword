#!/usr/bin/env bash
# Lokaler Notfallzugang, keine Passwörter in Argumenten oder Logs.
set -Eeuo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=script/common.sh
source "$SCRIPT_DIR/common.sh"
require_root
require_install
app_cli check
cd -- "$APP_DIR"
app_cli reset-admin-password "$@"
