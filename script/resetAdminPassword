#!/usr/bin/env bash
# Lokaler Notfallzugang, keine Passwörter in Argumenten oder Logs.
set -Eeuo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=script/common.sh
source "$SCRIPT_DIR/common.sh"
start_summary 'Admin-Passwort zurücksetzen'
require_root
require_install
app_cli check
cd -- "$APP_DIR"
app_cli reset-admin-password "$@"
SUMMARY_RESULT='Admin-Passwort geändert; bisherige Sitzungen dieses Kontos beendet.'
SUMMARY_NOTE='Mit der gewählten Admin-E-Mail und dem neu gesetzten Passwort anmelden. Das Passwort wird nicht ausgegeben.'
